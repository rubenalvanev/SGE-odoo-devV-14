<odoo>
    <data>
        <record id="view_ran_futbol_competicion_tree" model="ir.ui.view">
            <field name="name">ran_futbol.competicion.tree</field>
            <field name="model">ran_futbol.competicion</field>
            <field name="arch" type="xml">
                <tree string="Competición">
                    <field name="name"/>
                    <field name="tipo"/>
                    <field name="equipo_ids"/>
                    <field name="clasificacion_ids"/>
                </tree>
            </field>
        </record>

        <record id="view_ran_futbol_competicion_form" model="ir.ui.view">
            <field name="name">ran_futbol.competicion.form</field>
            <field name="model">ran_futbol.competicion</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="tipo"/>
                            <field name="equipo_ids"/>
                            <field name="clasificacion_ids"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
