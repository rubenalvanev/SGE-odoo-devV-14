<odoo>
    <data>
        <record id="view_ran_futbol_competicion_tree" model="ir.ui.view">
            <field name="name">ran_futbol.competicion.tree</field>
            <field name="model">ran_futbol.competicion</field>
            <field name="arch" type="xml">
                <tree string="Competición">
                    <field name="name"/>
                    <field name="tipo"/>
                    <field name="equipo_ids"/>
                </tree>
            </field>
        </record>

        <record id="view_ran_futbol_competicion_form" model="ir.ui.view">
            <field name="name">ran_futbol.competicion.form</field>
            <field name="model">ran_futbol.competicion</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="tipo"/>
                        </group>
                        <notebook>
                            <page string="Equipos">
                                <field name="equipo_ids" widget="many2many_tags"/>
                            </page>
                            <page string="Clasificación">
                                <field name="clasificacion_ids">
                                    <tree>
                                        <field name="equipo_id"/>
                                        <field name="puntos"/>
                                        <field name="diferencia_goles"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
