<odoo>
    <data>
        <record id="ran_futbol.equipo_view_tree" model="ir.ui.view">
            <field name="name">ran_futbol.equipo.tree</field>
            <field name="model">ran_futbol.equipo</field>
            <field name="arch" type="xml">
                <tree string="Equipo">
                    <field name="name" />
                    <field name="imagen" widget="image" />
                    <field name="dinero" optional="show" />
                    <field name="division" optional="show" />
                    <field name="goles" />
                    <field name="fecha_ultimo_partido" optional="show" />
                    <field name="jugador_ids" />
                    <field name="competicion_ids" />
                </tree>
            </field>
        </record>

        <record id="ran_futbol.equipo_view_form" model="ir.ui.view">
            <field name="name">ran_futbol.equipo.form</field>
            <field name="model">ran_futbol.equipo</field>
            <field name="arch" type="xml">
                <form string="Equipo">
                    <group name="name" string="string">
                        <field name="name" />
                        <field name="imagen" />
                        <field name="dinero" />
                        <field name="division" />
                        <field name="goles" />
                        <field name="fecha_ultimo_partido" />
                        <field name="jugador_ids" />
                        <field name="competicion_ids" />
                    </group>
                </form>
            </field>
        </record>

        <record id="ran_futbol_equipo_kanban_view" model="ir.ui.view">
            <field name="name">ran_futbol.equipo.kanban</field>
            <field name="model">ran_futbol.equipo</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column" default_group_by="division">
                    <field name="name"/>
                    <field name="dinero"/>
                    <field name="division"/>
                    <field name="goles" />
                    <field name="fecha_ultimo_partido"/>
                    <field name="jugador_ids"/>
                    <field name="imagen" />
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click d-flex flex-column p-2">
                                <strong class="o_kanban_record_title mb-1">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_avatar mb-2">
                                    <field name="imagen" widget="image"/>
                                </div>
                                <div class="o_kanban_record_subtitle mb-1">
                                    División: <t t-esc="record.division.value"/>
                                </div>
                                <div class="mb-1">
                                    Dinero: <field name="dinero" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                                    Goles: <field name="goles" />
                                </div>
                                <div class="mb-1">
                                    Último partido: <field name="fecha_ultimo_partido"/>
                                </div>
                                <div>
                                    Jugadores:
                                    <ul>
                                        <t t-foreach="record.jugador_ids.raw_value" t-as="jugador">
                                            <li><t t-esc="jugador[1]"/></li>
                                        </t>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    </data>
</odoo>